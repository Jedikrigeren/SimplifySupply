# Expo Configuration
# For WSL: Use your Windows machine's network IP (find with 'ipconfig' in Windows)
# For Mac/Linux: Use your local network IP (find with 'ifconfig' or 'ip addr')
# This controls the IP shown in the QR code for physical device connections
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.211

# Development Environment Configuration
# Set to "true" to automatically check for and start Android Emulator
# Set to "false" if using physical device or managing emulator manually
CHECK_ANDROID_EMULATOR=false